# Midterm Archive -- environment variables
# Copy to .env and fill in. Shares the same Neon DB and Gmail-sender infra as iran-archive.

# Neon PostgreSQL connection string -- get this from the Neon dashboard or from iran-archive's .env
DATABASE_URL=

# OpenAI (embeddings) and Anthropic (Claude synthesis)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Reuters Connect (refresh.py / probe script only -- not needed by the app at query time)
REUTERS_CLIENT_ID=
REUTERS_CLIENT_SECRET=

# Magic-link email (Gmail SMTP recommended) -- only needed for the hosted app, not the CLI scripts
EMAIL_ADDRESS=
EMAIL_PASSWORD=
SMTP_SERVER=
SMTP_PORT=

# Flask session signing key -- only needed for the hosted app. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
